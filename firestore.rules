rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // USER BALANCE SYNC - Each user sees own balance after Gmail signup
    match /chessbyethan_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // WALLET TRANSACTIONS - For real money history
    match /ethan_transactions/{transId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.data.userId == request.auth.uid;
    }

    // REFERRALS - Invite friend system
    match /ethan_referrals/{refId} {
      allow read, write: if request.auth != null;
    }

    // WITHDRAWALS - Users request bank payout
    match /ethan_withdrawals/{withdrawId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // GAME ROOMS - 12 Games
    match /chessbyethan_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /scrabble_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /ludo_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /draughts_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /whot_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /ayo_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /quiz_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /snake_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /penalty_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /soccer_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /racing_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
    match /headball_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
  }
}
